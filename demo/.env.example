APP_CONFIG=config/app.yaml
APP_ENV=development
APP_PUBLIC_ORIGIN=http://localhost:5173
# Local development also permits http://127.0.0.1:5173 in config/app.yaml.
# For another URL, set APP_PUBLIC_ORIGIN to its exact scheme, host and port.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SESSION_SECRET=replace-with-random-secret-at-least-32-bytes
APP_TURN_SHARED_SECRET=
APP_TURN_URLS=
# Optional external TURN service (use instead of APP_TURN_SHARED_SECRET).
APP_TURN_USERNAME=
APP_TURN_PASSWORD=
# scripts/start.ps1 share enables TURN automatically when these values are set.
# Example URLs: turn:YOUR_TURN_HOST:3478,turns:YOUR_TURN_HOST:5349?transport=tcp
# APP__RTC__ICE_TRANSPORT_POLICY=relay  # Only when a TURN server is configured.
