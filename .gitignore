# Codex・ローカル作業環境のメタデータ
/.agents/
/.codex/
/.local/

# 秘密情報・マシン固有設定（共有用の雛形は管理する）
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*credentials*.json
*secrets*.json

# 仮想環境・依存パッケージ・生成キャッシュ（依存定義・lockfileは管理する）
# 末尾の / を付けず、仮想環境へのシンボリックリンクも除外する
.venv
venv
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
*.egg-info/
.ipynb_checkpoints/
dist/
build/
coverage/
.coverage
htmlcov/

# エディタ・OSの生成物
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# 評価データは原則ローカル管理。保存方針とVSRの撮影用原稿のみ共有する
# 親ディレクトリを再包含してから script.txt だけを管理対象に戻す
/data/**
!/data/README.md
!/data/sign/
!/data/sign/README.md
!/data/vsr/
!/data/vsr/*/
!/data/vsr/*/script.txt
# 手話の原稿・撮影メタデータ・正解文・映像は引き続き除外する

# 上流コードも通常のファイルとしてルートのGitで管理する。
# 取得元・元revision・取り込み時の差分は research/upstream-sources.json を参照。

# 重み・前処理結果・実験の生出力（scripts/configs/reports/patchesは管理する）
/research/**/weights
/research/**/checkpoints
/research/**/outputs
/research/**/lightning_logs/
/research/**/multirun/
# 上流に同梱されていた学習データ・原稿・実演映像もローカル管理する。
# dataset/data という名前のPythonパッケージは一括除外しない。
/research/sign/uni-sign/Uni-Sign/data/
/research/sign/uni-sign/Uni-Sign/demo/rtmlib-main/demo.jpg
/research/vsr/auto_avsr/auto_avsr/preparation/vox-en.id
